<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="7dp"
    android:paddingBottom="7dp">

    <!-- Primary row: checkbox (selection) | timestamp | asset number | dot | type badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Selection checkbox — only visible in selection mode -->
        <CheckBox
            android:id="@+id/cbSelect"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:visibility="gone"
            android:clickable="false"
            android:focusable="false" />

        <!-- [HH:MM:SS] -->
        <TextView
            android:id="@+id/tvLogTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textSize="12sp"
            android:textColor="#A5D6A7"
            android:paddingEnd="10dp" />

        <!-- Asset Number -->
        <TextView
            android:id="@+id/tvLogAssetNumber"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#00E676"
            android:singleLine="true"
            android:ellipsize="end" />

        <!-- Sticker colour dot (12/24/60 mth routine period only) -->
        <View
            android:id="@+id/viewStickerDot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/circle_dot"
            android:visibility="gone" />

        <!-- FOUND / NEW badge -->
        <TextView
            android:id="@+id/tvLogType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="52dp"
            android:fontFamily="monospace"
            android:textSize="11sp"
            android:textStyle="bold"
            android:gravity="end"
            android:singleLine="true"
            android:letterSpacing="0.05" />

    </LinearLayout>

    <!-- Details row: only visible for NEW assets -->
    <TextView
        android:id="@+id/tvLogDetails"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="90dp"
        android:layout_marginTop="2dp"
        android:fontFamily="monospace"
        android:textSize="11sp"
        android:textColor="#C8E6C9"
        android:visibility="gone"
        android:singleLine="false"
        android:ellipsize="end" />

</LinearLayout>
