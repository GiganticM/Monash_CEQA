<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:divider="@null">

        <!-- ── Scanner name ───────────────────────────────────────────── -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Scanner Number"
            android:textStyle="bold"
            android:textSize="14sp"
            android:textColor="#1A1A2E" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Please enter the number on the scanner, \nOnly needed for initial setup."
            android:textSize="12sp"
            android:textColor="#666666"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Number on the scanner"
            app:placeholderText="e.g. 1">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etScannerName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:maxLines="1" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E0E0E0"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="16dp" />

        <!-- ── Output folder ─────────────────────────────────────────── -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="QA Record Storage Location"
            android:textStyle="bold"
            android:textSize="14sp"
            android:textColor="#1A1A2E" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Choose where to save the QA results."
            android:textSize="12sp"
            android:textColor="#666666"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnChangeFolder"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📁 Change Folder" />

        <TextView
            android:id="@+id/tvCurrentFolder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Loading..."
            android:textSize="11sp"
            android:textColor="#888888"
            android:layout_marginTop="4dp"
            android:ellipsize="middle"
            android:singleLine="true" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E0E0E0"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp" />

        <!-- ── LOG tab font size ──────────────────────────────────────── -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Logged QA Record Font Size"
            android:textStyle="bold"
            android:textSize="14sp"
            android:textColor="#1A1A2E" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="This changes the font size in the LOG tab."
            android:textSize="12sp"
            android:textColor="#666666"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="8dp" />

        <RadioGroup
            android:id="@+id/rgFontSize"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/rbFontSmall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Small"
                android:textSize="14sp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp" />

            <RadioButton
                android:id="@+id/rbFontMedium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Medium"
                android:textSize="14sp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp" />

            <RadioButton
                android:id="@+id/rbFontLarge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Large"
                android:textSize="14sp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp" />

        </RadioGroup>

    </LinearLayout>

</ScrollView>
